# ============================================================
# Virtual Path MES 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# docker compose 会自动读取根目录 .env
# ============================================================

# ---------- 部署必填 ----------
# JWT 密钥（网关/Java 服务/AI 服务共享，HS256，至少 32 字符）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# 智谱 AI API Key（不填则大模型对话/分析功能降级，预测服务不受影响）
ZHIPU_API_KEY=

# ---------- 中间件（有默认值，可改） ----------
MYSQL_ROOT_PASSWORD=123455
INFLUXDB_ADMIN_PASSWORD=123455
# InfluxDB token（compose 已内置默认值，重建容器后 token 不变；如需自定义请同步改 docker-compose.dev.yml 的 INFLUXDB_TOKEN）
# INFLUXDB_TOKEN=
EMQX_DEFAULT_PASSWORD=public

# ---------- 可选覆盖 ----------
# 网关跨域白名单（逗号分隔，支持通配；默认已含 localhost + https://*.reality-blog.asia）
# CORS_ALLOWED_ORIGINS=
# AI 服务监听覆盖（默认 0.0.0.0:8087）
# AI_HOST=
# AI_PORT=

# ============================================================
# 以下为「本地直跑（非 Docker）」时的连接配置，容器部署无需设置
# （compose 的 x-common-env 已自动注入容器内地址）
# ============================================================
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=123455
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# JWT_EXPIRATION=86400000
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=kUVlFGXR2YxkzRUzn9bW9dJazYkigOU6GyYlKLdGsF7ekBLLz9URVnOLMmFZViLy
# INFLUXDB_ORG=mes
# INFLUXDB_BUCKET=mes_metrics
# LOG_LEVEL=INFO
# 前端构建变量（docker 部署用 compose build.args，见 docker-compose.prod.yml）
# VITE_API_BASE_URL=/api
# VITE_AI_SERVICE_URL=/ai
# VITE_WS_URL=
