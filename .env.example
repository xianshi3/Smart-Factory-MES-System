# ============================================
# Smart Factory MES System - Environment Variables
# ============================================
# Copy this file to create your local config:
#   cp .env.example .env.local
# ============================================

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
JWT_SECRET=your-jwt-secret-at-least-256-bits-long
JWT_EXPIRATION=86400000

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
VITE_API_BASE_URL=
VITE_WS_URL=ws://localhost:8085/ws/dashboard
VITE_AI_SERVICE_URL=/api/ai

# --- AI Service ---
ZHIPU_API_KEY=your-api-key-here
