# ============================================
# Smart Factory MES System - Environment Variables
# ============================================
# Copy this file to create your local config:
#   cp .env.example .env
# ============================================

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123455
# docker-compose 使用（MySQL 容器初始密码）
MYSQL_ROOT_PASSWORD=123455

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
# 必填：长度 >= 32 的随机字符串，所有服务必须一致；不设置则服务启动失败。
# 本项目默认从根目录 .env 读取（见 application.yml 的 spring.config.import），
# 生产环境请通过环境变量注入。复制为 .env 后必须修改为随机值，勿使用占位符。
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- InfluxDB（mes-dashboard 时序存储，可选）---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=mes
INFLUXDB_BUCKET=mes_metrics

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_AI_SERVICE_URL=/ai

# --- AI Service ---
ZHIPU_API_KEY=your-api-key-here
