{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "MesDeviceGateway": "Debug"
    }
  },
  "Gateway": {
    "MqttServer": "localhost",
    "MqttPort": 1883,
    "MqttUsername": "admin",
    "MqttPassword": "public",
    "MqttReconnectIntervalMs": 5000,
    "KafkaBootstrapServers": "localhost:9092",
    "BatchSize": 100,
    "FlushIntervalMs": 1000,
    "ChannelBufferSize": 10000,
    "SlidingWindowSeconds": 10,
    "MaxDevices": 2000,
    "EnableIdempotent": true,
    "EnableHealthChecks": true,
    "RedisServer": "localhost",
    "RedisPort": 6379,
    "RedisPassword": "",
    "DeviceHeartbeatTtlSeconds": 90
  },
  "HealthChecks": {
    "Enabled": true
  }
}
